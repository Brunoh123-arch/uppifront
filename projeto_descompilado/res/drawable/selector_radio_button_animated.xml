<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:id="@id/checked" android:drawable="@drawable/ic_eats_radio_32" />
    <item android:id="@id/unchecked" android:drawable="@drawable/ic_eats_radio_unchecked_32" />
    <transition android:drawable="@drawable/radio_unchecked_checked" android:toId="@id/checked" android:fromId="@id/unchecked" />
    <transition android:drawable="@drawable/radio_checked_unchecked" android:toId="@id/unchecked" android:fromId="@id/checked" />
</animated-selector>