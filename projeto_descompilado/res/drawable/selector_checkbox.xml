<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:id="@id/checked" android:drawable="@drawable/ic_checkbox_checked" />
    <item android:state_checked="true" android:id="@id/selected" android:drawable="@drawable/ic_checkbox_checked" />
    <item android:id="@id/unchecked" android:drawable="@drawable/ic_checkbox_unchecked" />
    <transition android:drawable="@drawable/checkbox_unchecked_checked" android:toId="@id/checked" android:fromId="@id/unchecked" />
    <transition android:drawable="@drawable/checkbox_checked_unchecked" android:toId="@id/unchecked" android:fromId="@id/checked" />
    <transition android:drawable="@drawable/checkbox_unchecked_checked" android:toId="@id/selected" android:fromId="@id/unchecked" />
    <transition android:drawable="@drawable/checkbox_checked_unchecked" android:toId="@id/unchecked" android:fromId="@id/selected" />
</animated-selector>