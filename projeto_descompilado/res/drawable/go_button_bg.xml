<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/go_platform_accent_color"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/go_platform_accent_color_dark" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
            <item android:state_enabled="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/go_platform_accent_color" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/gray_250" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>